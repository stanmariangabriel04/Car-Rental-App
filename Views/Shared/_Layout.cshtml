@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - CarRental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet"/>
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true"/>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark fixed-top" id="mainNavbar">
    <div class="container">
        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
            <i class="fas fa-car-side text-warning me-2"></i>CarRental
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navContent">
            <ul class="navbar-nav me-auto gap-1">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fas fa-home me-1"></i>Acasa</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Cars" asp-action="Index"><i class="fas fa-car me-1"></i>Masini</a></li>
                @if (SignInManager.IsSignedIn(User))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Rentals" asp-action="MyRentals"><i class="fas fa-key me-1"></i>Inchirierile mele</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="fas fa-shield-halved me-1"></i>Admin</a>
                            <ul class="dropdown-menu dropdown-menu-dark">
                                <li><a class="dropdown-item" asp-controller="Cars" asp-action="Create"><i class="fas fa-plus me-2"></i>Adauga masina</a></li>
                                <li><a class="dropdown-item" asp-controller="Rentals" asp-action="Index"><i class="fas fa-list me-2"></i>Toate inchirierile</a></li>
                            </ul>
                        </li>
                    }
                }
            </ul>
            <ul class="navbar-nav align-items-center gap-2">
                @if (SignInManager.IsSignedIn(User))
                {
                    var cu = await UserManager.GetUserAsync(User);
                    var img = cu?.ProfileImagePath ?? "/images/default-avatar.svg";
                    var dname = cu?.FirstName ?? User.Identity!.Name?.Split('@')[0] ?? "User";
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
                            <img src="@img" class="nav-avatar" onerror="this.src='/images/default-avatar.svg'"/>
                            <span>@dname</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                            <li class="dropdown-header text-warning">@(cu?.FullName ?? "Utilizator")</li>
                            <li><hr class="dropdown-divider border-secondary"></li>
                            <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="fas fa-user-circle me-2"></i>Profilul meu</a></li>
                            <li><hr class="dropdown-divider border-secondary"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger"><i class="fas fa-right-from-bracket me-2"></i>Deconectare</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login"><i class="fas fa-right-to-bracket me-1"></i>Login</a></li>
                    <li class="nav-item"><a class="btn btn-warning btn-sm fw-bold px-3" asp-controller="Account" asp-action="Register">Inregistrare</a></li>
                }
            </ul>
        </div>
    </div>
</nav>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show position-fixed end-0 m-3 shadow" style="z-index:9999;top:80px;min-width:280px">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<main style="padding-top:70px;">@RenderBody()</main>

<footer class="footer-dark mt-5 py-4">
    <div class="container text-center">
        <p class="mb-1 fw-bold"><i class="fas fa-car-side text-warning me-2"></i>CarRental</p>
        <p class="text-muted small mb-0">Proiect PAW &copy; @DateTime.Now.Year &mdash; ASP.NET Core MVC + Entity Framework</p>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
