@model LoginViewModel
@{ ViewData["Title"]="Autentificare"; }
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo">
            <i class="fas fa-car-side text-warning fa-2x"></i>
            <h2 class="mt-2 fw-bold">CarRental</h2>
            <p class="text-muted">Bun venit inapoi!</p>
        </div>
        <form asp-action="Login" method="post">
            <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]"/>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold">Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-envelope text-muted"></i></span>
                    <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="exemplu@email.ro"/>
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold">Parola</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-lock text-muted"></i></span>
                    <input asp-for="Password" class="form-control border-start-0 ps-0" placeholder="••••••••"/>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="mb-4 d-flex align-items-center">
                <input asp-for="RememberMe" class="form-check-input me-2"/>
                <label asp-for="RememberMe" class="form-check-label text-muted">Tine-ma minte</label>
            </div>
            <button type="submit" class="btn btn-warning fw-bold w-100 py-2"><i class="fas fa-right-to-bracket me-2"></i>Autentificare</button>
        </form>
        <hr class="my-4">
        <p class="text-center text-muted mb-0">Nu ai cont? <a asp-controller="Account" asp-action="Register" class="text-warning fw-bold text-decoration-none">Inregistreaza-te</a></p>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
