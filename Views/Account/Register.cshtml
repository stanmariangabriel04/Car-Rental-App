@model RegisterViewModel
@{ ViewData["Title"]="Inregistrare"; }
<div class="auth-page">
    <div class="auth-card" style="max-width:520px">
        <div class="auth-logo">
            <i class="fas fa-car-side text-warning fa-2x"></i>
            <h2 class="mt-2 fw-bold">Cont nou</h2>
            <p class="text-muted">Inregistrare gratuita</p>
        </div>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
            <div class="row mb-3">
                <div class="col">
                    <label asp-for="FirstName" class="form-label fw-semibold">Prenume</label>
                    <input asp-for="FirstName" class="form-control" placeholder="Ion"/>
                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                </div>
                <div class="col">
                    <label asp-for="LastName" class="form-label fw-semibold">Nume</label>
                    <input asp-for="LastName" class="form-control" placeholder="Popescu"/>
                    <span asp-validation-for="LastName" class="text-danger small"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold">Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-envelope text-muted"></i></span>
                    <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="exemplu@email.ro"/>
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold">Parola</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-lock text-muted"></i></span>
                    <input asp-for="Password" class="form-control border-start-0 ps-0" placeholder="Min. 6 caractere"/>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirma parola</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-lock text-muted"></i></span>
                    <input asp-for="ConfirmPassword" class="form-control border-start-0 ps-0" placeholder="Repeta parola"/>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-warning fw-bold w-100 py-2"><i class="fas fa-user-plus me-2"></i>Creeaza cont</button>
        </form>
        <hr class="my-4">
        <p class="text-center text-muted mb-0">Ai deja cont? <a asp-controller="Account" asp-action="Login" class="text-warning fw-bold text-decoration-none">Autentifica-te</a></p>
    </div>
</div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
