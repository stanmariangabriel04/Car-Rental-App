@model IEnumerable<CarRentalApp.Models.Rental>
@{ ViewData["Title"]="Inchirierile mele"; }
<div class="page-header">
    <div class="container">
        <h1 class="page-title"><i class="fas fa-key me-3"></i>Inchirierile Mele</h1>
        <p class="page-subtitle">@Model.Count() inchirieri totale</p>
    </div>
</div>
<div class="container py-4">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-car text-muted" style="font-size:4rem"></i>
            <h4 class="mt-3">Nu ai nicio inchiriere inca</h4>
            <p class="text-muted">Descopera masinile noastre si fa prima rezervare!</p>
            <a asp-controller="Cars" asp-action="Index" class="btn btn-warning fw-bold px-4 mt-2"><i class="fas fa-search me-2"></i>Cauta masini</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var r in Model)
            {
                <div class="col-lg-6">
                    <div class="rental-card">
                        <div class="rental-card-header">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="rental-id">#@r.Id</span>
                                @if (r.Status == CarRentalApp.Models.RentalStatus.Active)
                                {<span class="badge bg-success fs-6 px-3">Activ</span>}
                                else if (r.Status == CarRentalApp.Models.RentalStatus.Completed)
                                {<span class="badge bg-secondary fs-6 px-3">Finalizat</span>}
                                else
                                {<span class="badge bg-danger fs-6 px-3">Anulat</span>}
                            </div>
                        </div>
                        <div class="rental-card-body">
                            <div class="d-flex gap-3 align-items-center mb-3">
                                <img src="@(r.Car?.ImageUrl ?? "/images/cars/default-car.png")" class="rounded" style="width:80px;height:55px;object-fit:cover" onerror="this.src='/images/cars/default-car.png'"/>
                                <div><h5 class="mb-0 fw-bold">@r.Car?.Brand @r.Car?.Model</h5><small class="text-muted">@r.Car?.CarCategory?.Name &bull; @r.Car?.Year</small></div>
                            </div>
                            <div class="rental-details">
                                <div class="rental-detail-item"><i class="fas fa-calendar-check text-success"></i><span>Ridicare: <strong>@r.StartDate.ToString("dd.MM.yyyy")</strong></span></div>
                                <div class="rental-detail-item"><i class="fas fa-calendar-xmark text-danger"></i><span>Returnare: <strong>@r.EndDate.ToString("dd.MM.yyyy")</strong></span></div>
                                <div class="rental-detail-item"><i class="fas fa-map-marker-alt text-warning"></i><span>@r.PickupLocation?.Name</span></div>
                                <div class="rental-detail-item"><i class="fas fa-credit-card text-info"></i><span>@(r.Payment?.PaymentMethod ?? "N/A") &bull; @(r.Payment?.IsPaid==true ? "Platit" : "Neplatit")</span></div>
                            </div>
                        </div>
                        <div class="rental-card-footer d-flex justify-content-between align-items-center">
                            <div class="fw-bold fs-5 text-warning">@r.TotalPrice RON <small class="text-muted fw-normal fs-6">/ @r.DaysCount zile</small></div>
                            @if (r.Status == CarRentalApp.Models.RentalStatus.Active)
                            {<a asp-controller="Rentals" asp-action="EndRental" asp-route-id="@r.Id" class="btn btn-outline-success btn-sm" onclick="return confirm('Confirmi returnarea masinii?')"><i class="fas fa-check me-1"></i>Returneaza masina</a>}
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
