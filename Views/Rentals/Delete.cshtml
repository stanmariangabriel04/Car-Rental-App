@model CarRentalApp.Models.Rental
@{ ViewData["Title"]="Sterge inchiriere"; }
<div class="container py-5" style="max-width:500px">
    <div class="admin-form-card text-center">
        <div class="text-danger mb-3" style="font-size:3rem"><i class="fas fa-triangle-exclamation"></i></div>
        <h3 class="fw-bold mb-2">Sterge inchirierea #@Model.Id</h3>
        <p class="text-muted">@Model.Car?.Brand @Model.Car?.Model &mdash; <strong>@Model.TotalPrice RON</strong></p>
        <p class="text-muted small">@Model.StartDate.ToString("dd.MM.yyyy") - @Model.EndDate.ToString("dd.MM.yyyy")</p>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id"/>
            <div class="d-flex gap-3 justify-content-center mt-3">
                <button type="submit" class="btn btn-danger fw-bold px-4"><i class="fas fa-trash me-2"></i>Sterge</button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Anuleaza</a>
            </div>
        </form>
    </div>
</div>
