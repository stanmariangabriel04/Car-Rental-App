@model IEnumerable<CarRentalApp.Models.Rental>
@{ ViewData["Title"]="Toate inchirierile (Admin)"; }
<div class="page-header">
    <div class="container">
        <h1 class="page-title"><i class="fas fa-list-check me-3"></i>Toate Inchirierile</h1>
        <p class="page-subtitle">Total: @Model.Count() inchirieri</p>
    </div>
</div>
<div class="container py-4">
    <div class="table-responsive rounded-3 shadow-sm">
        <table class="table table-hover align-middle mb-0 bg-white">
            <thead class="table-dark">
                <tr><th>#</th><th>Masina</th><th>Utilizator</th><th>Perioada</th><th>Locatie</th><th>Pret</th><th>Plata</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td><span class="fw-bold text-muted">#@r.Id</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="@(r.Car?.ImageUrl ?? "/images/cars/default-car.png")" class="rounded" style="width:50px;height:35px;object-fit:cover" onerror="this.src='/images/cars/default-car.png'"/>
                                <div><div class="fw-bold">@r.Car?.Brand @r.Car?.Model</div><small class="text-muted">@r.Car?.Year</small></div>
                            </div>
                        </td>
                        <td><div class="fw-bold">@r.User?.FullName</div><small class="text-muted">@r.User?.Email</small></td>
                        <td><small>@r.StartDate.ToString("dd.MM.yy") &rarr; @r.EndDate.ToString("dd.MM.yy")</small><div><span class="badge bg-light text-dark">@r.DaysCount zile</span></div></td>
                        <td><small>@r.PickupLocation?.City</small></td>
                        <td><span class="fw-bold text-warning">@r.TotalPrice RON</span></td>
                        <td><small>@(r.Payment?.PaymentMethod??"-")</small></td>
                        <td>
                            @if(r.Status==CarRentalApp.Models.RentalStatus.Active){<span class="badge bg-success">Activ</span>}
                            else if(r.Status==CarRentalApp.Models.RentalStatus.Completed){<span class="badge bg-secondary">Finalizat</span>}
                            else{<span class="badge bg-danger">Anulat</span>}
                        </td>
                        <td><a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
