@model IEnumerable<CarRentalApp.Models.Car>
@{ ViewData["Title"]="Toate masinile"; }
<div class="page-header">
    <div class="container">
        <h1 class="page-title"><i class="fas fa-car me-3"></i>Toate Masinile</h1>
        <p class="page-subtitle">@Model.Count() masini in flota noastra</p>
        @if (User.IsInRole("Admin"))
        {<a asp-action="Create" class="btn btn-warning fw-bold mt-2"><i class="fas fa-plus me-2"></i>Adauga masina</a>}
    </div>
</div>
<div class="container py-4">
    <div class="row g-4">
        @foreach (var car in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="car-card h-100">
                    <div class="car-card-image">
                        <img src="@(car.ImageUrl ?? "/images/cars/default-car.png")" alt="@car.Brand @car.Model" onerror="this.src='/images/cars/default-car.png'"/>
                        <span class="car-badge">@car.CarCategory?.Name</span>
                        @if (!car.IsAvailable){<div class="unavailable-overlay"><i class="fas fa-ban me-2"></i>Indisponibil</div>}
                    </div>
                    <div class="car-card-body">
                        <h5 class="car-name">@car.Brand @car.Model <span class="car-year">@car.Year</span></h5>
                        <div class="car-meta">
                            <span><i class="fas fa-map-marker-alt me-1"></i>@car.Location?.Name</span>
                            @if (car.Reviews.Any()){<span><i class="fas fa-star text-warning me-1"></i>@car.AverageRating.ToString("F1") (@car.Reviews.Count)</span>}
                        </div>
                        <div class="car-footer">
                            <div class="car-price"><span class="price-amount">@car.PricePerDay</span> RON<span class="price-per">/zi</span></div>
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-action="Details" asp-route-id="@car.Id" class="btn btn-outline-dark btn-sm"><i class="fas fa-eye me-1"></i>Detalii</a>
                                @if (User.Identity!.IsAuthenticated && car.IsAvailable)
                                {<a asp-controller="Rentals" asp-action="Rent" asp-route-carId="@car.Id" class="btn btn-warning btn-sm fw-bold">Inchiriaza</a>}
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-sm btn-outline-secondary"><i class="fas fa-edit"></i></a>
                                    <a asp-action="Delete" asp-route-id="@car.Id" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
